# Rename to .env and fill in to enable real email sending.
# If left unset, PlayNest runs in DEV MODE: OTPs are printed to the
# console and shown in a flash banner instead of being emailed.

SECRET_KEY=change-this-to-a-long-random-string
FLASK_ENV=development
FLASK_DEBUG=True

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=PlayNest <no-reply@playnest.app>

# Set to True once real DB integration replaces the mock repositories
DATABASE_READY=False
